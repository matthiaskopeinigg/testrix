{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@testrix/contracts": ["packages/contracts/src/index.ts"],
      "@testrix/design-tokens": ["packages/design-tokens/src/index.ts"],
      "@testrix/motion": ["packages/motion/src/index.ts"],
      "@testrix/ui": ["packages/ui/src/index.ts"],
      "@testrix/electron-core": ["packages/electron-core/src/index.ts"],
      "@testrix/persistence": ["packages/persistence/src/index.ts"],
      "@testrix/http-engine": ["packages/http-engine/src/index.ts"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "ignoreDeprecations": "6.0",
    "declaration": true,
    "sourceMap": true
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
