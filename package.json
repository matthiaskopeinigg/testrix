{
  "name": "testrix",
  "version": "2.0.0",
  "description": "Testrix — local-first desktop API workbench",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": {
    "name": "Matthias Kopeinigg"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/matthiaskopeinigg/testrix.git"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node tooling/scripts/serve-desktop.mjs --devtools",
    "start": "node tooling/scripts/serve-desktop.mjs",
    "start:compare": "cross-env TESTRIX_COMPARE=1 node tooling/scripts/serve-desktop.mjs",
    "build": "npm run sync:brand && npm run build --workspace=@testrix/renderer && npm run electron:bundle",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "test:components": "npm run test:components --workspace=@testrix/renderer",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:flows": "vitest run apps/renderer/src/app/features/services/flows",
    "test:flows:coverage": "vitest run apps/renderer/src/app/features/services/flows --coverage.enabled --coverage.provider=v8 --coverage.include=apps/renderer/src/app/features/services/flows/flow-canvas-actions.ts --coverage.thresholds.lines=90 --coverage.thresholds.functions=90 --coverage.thresholds.branches=90 --coverage.thresholds.statements=90 --coverage.reporter=text --coverage.reporter=html",
    "test:collections": "vitest run apps/renderer/src/app/features/collections",
    "test:tools": "vitest run apps/renderer/src/app/features/tools",
    "test:database": "vitest run apps/renderer/src/app/features/database",
    "test:environments": "vitest run apps/renderer/src/app/features/environments",
    "lint": "eslint .",
    "lint:styles": "stylelint \"apps/*/src/**/*.scss\" \"packages/*/src/**/*.scss\"",
    "format:check": "prettier --check \"*.{json,yml,yaml}\" \".github/**/*.{yml,yaml}\" \"apps/*/*.json\" \"packages/*/*.json\" \"tooling/**/*.mjs\" \"docker/*.{yml,yaml}\"",
    "typecheck": "tsc -p apps/desktop/tsconfig.json --noEmit && tsc -p apps/setup/tsconfig.json --noEmit && tsc -p apps/renderer/tsconfig.app.json --noEmit && tsc -p apps/renderer/tsconfig.spec.json --noEmit && tsc -p tsconfig.packages.json",
    "verify": "npm run lint && npm run lint:styles && npm run format:check && npm run typecheck && npm run test:coverage && npm run test:components && npm run check:docs",
    "test:all": "npm run verify && npm run build && npm run test:e2e",
    "check:docs": "node tooling/scripts/check-doc-links.mjs",
    "sync:brand": "node tooling/scripts/sync-brand-assets.mjs",
    "electron:bundle": "node tooling/scripts/bundle-electron.mjs",
    "setup:preview": "node tooling/scripts/preview-ui.mjs installer",
    "setup:preview:uninstall": "node tooling/scripts/preview-ui.mjs uninstaller",
    "preview:splash": "node tooling/scripts/preview-ui.mjs splash",
    "preview:boot-error": "node tooling/scripts/preview-ui.mjs boot-error",
    "preview:app-error": "node tooling/scripts/preview-ui.mjs app-error",
    "preview:installer": "node tooling/scripts/preview-ui.mjs installer",
    "preview:uninstaller": "node tooling/scripts/preview-ui.mjs uninstaller",
    "electron:build:win:payload": "node tooling/scripts/pack-payload.mjs --platform=win",
    "electron:build:win:setup": "node tooling/scripts/pack-setup.mjs --platform=win",
    "electron:pack": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run electron:build:win:payload && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run electron:build:win:setup",
    "electron:pack:desktop": "node tooling/scripts/pack-desktop.mjs",
    "release:bump": "node tooling/scripts/bump-version.mjs",
    "release:manifest": "node tooling/scripts/release-manifest.mjs",
    "updater:keygen": "node tooling/scripts/updater-keygen.mjs",
    "updater:local": "node tooling/scripts/updater-local.mjs",
    "updater:preview": "node tooling/scripts/updater-local.mjs",
    "db:up": "docker compose --project-directory docker up -d",
    "db:down": "docker compose --project-directory docker down",
    "db:reset": "docker compose --project-directory docker down -v && docker compose --project-directory docker up -d",
    "db:ps": "docker compose --project-directory docker ps"
  },
  "overrides": {
    "basic-ftp": "6.2.2",
    "@graphql-tools/utils": "12.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.5.0",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
