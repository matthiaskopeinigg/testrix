# Testrix is offline-first. You do not need a .env file to run or package the app.
# Copy to .env only if you use optional local overrides during development.
#
# Examples (uncomment and set as needed):
# TESTRIX_NO_SPLASH=1
# TESTRIX_DEV_URL=http://localhost:4200
# TESTRIX_COMPARE=1
#
# Collab uses Git. SSH remotes and proxy/custom-CA setups need the system git binary;
# set GIT_PATH only when it is not on PATH.
# GIT_PATH=C:\Program Files\Git\cmd\git.exe
