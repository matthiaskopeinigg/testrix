{
  "name": "@testrix/setup",
  "version": "2.0.0-beta.1",
  "private": true,
  "main": "dist/main.cjs",
  "productName": "Testrix Setup",
  "scripts": {
    "start": "electron .",
    "build": "node ../../tooling/scripts/bundle-setup.mjs",
    "pack:win": "electron-builder build --win portable --publish never"
  },
  "dependencies": {
    "@testrix/contracts": "2.0.0-beta.1",
    "@testrix/electron-core": "2.0.0-beta.1"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.testrix.app.setup",
    "productName": "Testrix Setup",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "../../release/setup-shell-build",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "portable": {
      "artifactName": "Testrix-Setup.${ext}",
      "unpackDirName": "TestrixSetup"
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Testrix-Setup.${ext}",
      "category": "Development"
    }
  }
}
